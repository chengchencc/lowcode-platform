# docker compose 的变量（`docker compose up` 会自动读同目录的 .env）。
#
# 只用于容器化部署；本机直跑前后端时走的是 backend/.env（见 backend/.env.example）。

# ---- 必改 ----
# JWT 签名密钥。生成：openssl rand -hex 32
# 留空会直接启动失败（compose 里写了 :? 校验）—— 用默认值上线等于谁都能伪造 token
JWT_SECRET=

# ---- 数据库形态 ----
# 留空 / postgres = 使用 compose 内置的 PostgreSQL 16（默认）
# mysql           = 使用 compose 内置的 MySQL 8（等价于 docker-up.sh --mysql）
DB_MODE=postgres

# PostgreSQL 的库名 / 账号 / 密码（默认形态）
PG_DATABASE=flowform
PG_USER=flowform
PG_PASSWORD=flowform123

# MySQL（DB_MODE=mysql 时生效）
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=flowform
MYSQL_USER=flowform
MYSQL_PASSWORD=flowform123

# ---- 初始管理员（首次启动创建，已存在则跳过）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@example.com

# ---- 构建加速 ----
# 镜像构建时安装依赖用的源，默认国内镜像（compose 里也有同样的默认值）。
# 海外环境或镜像源不可用时改成官方源：
#   PIP_INDEX_URL=https://pypi.org/simple
#   NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# ---- 站点 ----
WEB_PORT=8080
MAX_UPLOAD_MB=20

# 同源部署（nginx 反代 /api）时留空即可；前后端分域名部署时填前端地址，逗号分隔
CORS_ORIGINS=

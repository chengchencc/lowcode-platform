# 复制为 backend/.env 后按需修改。

# ---- 应用 ----
APP_NAME=FlowForm
DEBUG=true
# 前端来源，逗号分隔。Vite 开发服务器默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 数据库 ----
# 开发默认 SQLite（零依赖）。注意是 4 个斜杠 —— 相对路径写在 URL 里。
DATABASE_URL=sqlite:///./flowform.db
#
# 切 MySQL 8（PRD §6 的目标形态）时改用下面这行，其余什么都不用动：
#   1) docker compose -f docker-compose.dev.yml up -d
#   2) cd backend && alembic upgrade head
#
# DATABASE_URL=mysql+pymysql://flowform:flowform123@127.0.0.1:3306/flowform?charset=utf8mb4

# 打印所有 SQL，排查问题时开
SQL_ECHO=false

# ---- 认证 ----
# 生产必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---- 初始化管理员（F6.5，首次启动自动创建；已存在则跳过）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_REAL_NAME=平台管理员
ADMIN_EMAIL=admin@example.com
# 是否顺带建内置角色 + 示例部门树
SEED_DEMO_ORG=true

# ---- 展示时区 ----
# 数据存 UTC；首页「今日/本周/本月」按该时区计算
APP_TIMEZONE=Asia/Shanghai

# ---- AI 辅助配置（M15，默认关闭）----
# 开启前需完成网络例外与模型供应商审批；密钥只放后端环境变量
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4000
# 每用户每小时生成次数上限
AI_RATE_LIMIT_PER_HOUR=20
